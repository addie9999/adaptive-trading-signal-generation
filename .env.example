# Copy to .env and adjust. All keys use the AQAF__SECTION__KEY convention and
# override the YAML config at load time.

# Select the config environment layer (research | production).
AQAF_ENV=research

# Override the signal-store database (defaults to local Postgres).
# AQAF__DATABASE__URL=postgresql+psycopg2://aqaf:aqaf@localhost:5432/aqaf

# MLflow tracking server (defaults to a local ./mlruns file store).
# AQAF__TRACKING__TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_URI=http://localhost:5000

# Optional data-provider API keys (for future providers).
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=
